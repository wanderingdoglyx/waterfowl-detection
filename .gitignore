# ── Data: raw datasets and everything generated from them (huge, not for git) ──
dataset_full/*
# ...but keep the metadata inventory, which is documentation rather than data.
# (`dataset_full/*` rather than `dataset_full/` so this negation can take effect — git
# cannot re-include a file whose parent directory is itself excluded.)
!dataset_full/DATASET_INVENTORY.md
dataset_v1/
dataset/
crops/
yolov5_data/

# output/ IS versioned (metrics, configs, curves, example images, logs, crops_json)
# EXCEPT model weights (*.pt / *.pth, ignored globally below) and any file over
# GitHub's 100 MB hard limit — gitignore can't filter by size, so oversized files
# must be listed here explicitly.  Check before committing new runs:
#   find output -type f -size +100M ! -name "*.pth" ! -name "*.pt"
output/checkpoints/mdo_owl_c/2026-07-21_22-59-50/20260722_validation.log
# OWL point-CSV mirror of the crops (symlinks + gt.csv)
mdo_data/

# ── Third-party research repos cloned locally (MegaDetector-Overhead + its .venv,
#    vendored DINOv3, and multi-GB Zenodo weights) ──────────────────────────────
third_party/

# ── Model weights (downloaded pretrained or trained checkpoints) ───────────────
*.pt
*.pth

# ── Reference paper / large binaries ──────────────────────────────────────────
*.pdf

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# ── Editor / tooling (machine-specific) ───────────────────────────────────────
.vscode/
.claude/
.idea/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
